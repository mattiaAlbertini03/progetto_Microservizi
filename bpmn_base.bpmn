    <bpmn:textAnnotation id="TextAnnotation_18qw82c">
      <bpmn:text>DOVREI INSERIRE UNA TASK PER INDICARE CHE DEVE SVOLGERE L'AZIONE DI RIMOZIONE O NON IMPORTA?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1sfqvyf" associationDirection="None" sourceRef="Participant_1yi1ed2" targetRef="TextAnnotation_18qw82c" />
    <bpmn:textAnnotation id="TextAnnotation_1jqtl3n">
      <bpmn:text>elemento aggiunto per separare meglio le funzioni del sistema. per renderne più semplice l'implementazione</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1hoafdg">
      <bpmn:text>ho scelto user e manul task per gestire ciò che dovrebbe fare un utente senza dover avere un'altra pool</bpmn:text>
    </bpmn:textAnnotation>

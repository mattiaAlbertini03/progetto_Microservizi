    <bpmn:textAnnotation id="TextAnnotation_0rc0b4x">
      <bpmn:text>in attesa di un msg da ACME</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1jqtl3n">
      <bpmn:text>elemento aggiunto per separare meglio le funzioni del sistema. per renderne più semplice l'implementazione</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02nit73">
      <bpmn:text>la prenotazione deve avvenire con un anticipo di massimo 30 min.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_00w2328">
      <bpmn:text>tiene memorai dello spostamento cosi da poter far poi i conti</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sxr7t7">
      <bpmn:text>richiesto annulamento troppo tardi</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:serviceTask id="Activity_0u4ifg5" name="Bank connection" zeebe:modelerTemplate="io.camunda:soap" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:soap:1" retries="3" />
        <zeebe:ioMapping type="io.camunda:soap:1">
          <zeebe:input source="http://banking-service.acme:8080" target="serviceUrl" />
          <zeebe:input source="none" target="authentication.authentication" />
          <zeebe:input source="1.1" target="soapVersion.version" />
          <zeebe:input source="login" target="soapVersion.soapAction" />
          <zeebe:input source="none" target="header.type" />
          <zeebe:input source="template" target="body.type" />
          <zeebe:input source="&#60;login xmlns=&#34;mytest.test.com.xsd&#34;&#62;&#10;  &#60;name&#62;{{username}}&#60;/name&#62;&#10;  &#60;conto&#62;{{account}}&#60;/conto&#62;&#10;  &#60;ricarica&#62;{{deposit}}&#60;/ricarica&#62;&#10;&#60;/login&#62;" target="body.template" />
          <zeebe:input source="=bankLoginPayload" target="body.context" />
          <zeebe:input source="={}" target="namespaces" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="2" />
          <zeebe:header key="elementTemplateId" value="io.camunda:soap" />
          <zeebe:header key="resultVariable" value="bancaId" />
          <zeebe:header key="resultExpression" value="={bancaId: Envelope.Body.login.sid}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zp3zvs</bpmn:incoming>
      <bpmn:outgoing>Flow_0rn9dwl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0vcdypw" name="Block vehicle" zeebe:modelerTemplate="io.camunda:soap" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">

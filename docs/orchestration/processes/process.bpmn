    <bpmn:serviceTask id="Activity_0bday98" name="Charge user" zeebe:modelerTemplate="io.camunda:soap" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:soap:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=services.banking" target="serviceUrl" />
          <zeebe:input source="none" target="authentication.authentication" />
          <zeebe:input source="1.1" target="soapVersion.version" />
          <zeebe:input source="charge" target="soapVersion.soapAction" />
          <zeebe:input source="none" target="header.type" />
          <zeebe:input source="template" target="body.type" />
          <zeebe:input source="&#60;charge xmlns=&#34;urn:acme:banking.xsd&#34;&#62;&#10;  &#60;sessionId&#62;{{bankSessionId}}&#60;/sessionId&#62;&#10;  &#60;amount&#62;{{amount}}&#60;/amount&#62;&#10;&#60;/charge&#62;" target="body.template" />
          <zeebe:input source="={&#10;  bankSessionId: bankSessionId,&#10;  amount: finalAmount&#10;}" target="body.context" />
          <zeebe:input source="={}" target="namespaces" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>

    <bpmn:serviceTask id="Activity_0gml4c3" name="Notify low-battery penalty" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">

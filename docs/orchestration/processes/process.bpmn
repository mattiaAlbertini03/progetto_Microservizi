    <bpmn:serviceTask id="Activity_0u4ifg5" name="Bank connection" zeebe:modelerTemplate="io.camunda:soap" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">

          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=services.acme + &#34;/reservation-requests/&#34; + reservationRequest.requestId + &#34;/events&#34;" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
